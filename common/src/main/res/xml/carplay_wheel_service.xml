<?xml version="1.0" encoding="utf-8"?>
<!-- Steering-wheel joystick for CarPlay (Settings > Experimental): key filtering only, no window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/carplay_wheel_service_description"
    android:notificationTimeout="200" />
